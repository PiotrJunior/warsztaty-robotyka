<!-- Opis zadania i polecenie uruchomienia: na końcu pliku. -->
<mujoco model="Moj chwytak">
  <compiler autolimits="true" angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="135" elevation="-30" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture name="table" type="2d" builtin="checker" rgb1="0.55 0.5 0.45" rgb2="0.5 0.45 0.4" width="300" height="300"/>
    <material name="table" texture="table" texrepeat="8 8"/>
  </asset>

  <worldbody>
    <light pos="0.5 -0.5 2.0" dir="-0.25 0.25 -1" directional="true"/>
    <geom name="table" type="plane" size="1.2 1.2 0.05" material="table"/>
    <geom name="tower_spot" type="cylinder" pos="0.35 -0.25 0.0005" size="0.05 0.0005" rgba="0.1 0.8 0.3 1" contype="0" conaffinity="0"/>

    <body name="toy_1" pos="-0.1 0.2 0.035">
      <freejoint/>
      <geom type="box" size="0.035 0.035 0.035" rgba="0.9 0.3 0.2 1" mass="0.05"/>
    </body>
    <body name="toy_2" pos="0.15 0.1 0.035">
      <freejoint/>
      <geom type="box" size="0.035 0.035 0.035" rgba="0.2 0.5 0.9 1" mass="0.05"/>
    </body>

    <body name="gripper" pos="0 0 0" gravcomp="1">
      <joint name="gx" type="slide" axis="1 0 0" range="-0.7 0.7" damping="5"/>
      <joint name="gy" type="slide" axis="0 1 0" range="-0.7 0.7" damping="5"/>
      <joint name="gz" type="slide" axis="0 0 1" range="0.07 0.9" damping="5"/>
      <joint name="gyaw" type="hinge" axis="0 0 1" range="-3.2 3.2" damping="0.5"/>
      <geom name="gripper_body" type="box" pos="0.04 0 0.06" size="0.07 0.03 0.02" rgba="0.6 0.62 0.68 1" mass="0.3"/>
      <geom type="cylinder" pos="0 0 0.03" size="0.012 0.02" rgba="0.15 0.15 0.18 1" mass="0.05"/>
      <geom name="suction_cup" type="cylinder" pos="0 0 0.005" size="0.02 0.005" rgba="0.9 0.2 0.2 1" mass="0.02"/>
      <site name="suction" pos="0 0 0" size="0.005" rgba="1 0 0 1"/>
      <geom type="box" pos="0.09 0 0.035" size="0.015 0.015 0.01" rgba="0.15 0.15 0.18 1" mass="0.02"/>
      <camera name="gripper_camera" pos="0.09 0 0.02" xyaxes="0 -1 0 1 0 0" fovy="70"/>

      <!-- dwa palce: prostopadłościany, które jeżdżą do środka (oś y) -->
      <body name="finger_left" pos="0 0.065 -0.03" gravcomp="1">
        <joint name="fl" type="slide" axis="0 -1 0" range="0 0.05" damping="2"/>
        <geom type="box" size="0.02 0.008 0.03" rgba="0.95 0.65 0.1 1" mass="0.02" friction="1.5"/>
      </body>
      <body name="finger_right" pos="0 -0.065 -0.03" gravcomp="1">
        <joint name="fr" type="slide" axis="0 1 0" range="0 0.05" damping="2"/>
        <geom type="box" size="0.02 0.008 0.03" rgba="0.95 0.65 0.1 1" mass="0.02" friction="1.5"/>
      </body>
    </body>
  </worldbody>

  <equality>
    <joint joint1="fr" joint2="fl" solref="0.004 1"/>  <!-- prawy palec rusza się tak samo jak lewy -->
  </equality>

  <actuator>
    <position name="ax" joint="gx" kp="800" dampratio="1" forcerange="-20 20" ctrlrange="-0.7 0.7"/>
    <position name="ay" joint="gy" kp="800" dampratio="1" forcerange="-20 20" ctrlrange="-0.7 0.7"/>
    <position name="az" joint="gz" kp="800" dampratio="1" forcerange="-20 20" ctrlrange="0.07 0.9"/>
    <position name="ayaw" joint="gyaw" kp="20" dampratio="1" ctrlrange="-3.2 3.2" forcerange="-1 1"/>
    <position name="agrip" joint="fl" kp="200" dampratio="1" ctrlrange="0 0.05"/>  <!-- 0 = otwarte, 0.05 = zamknięte -->
  </actuator>

  <sensor>
    <jointpos name="sx" joint="gx"/>
    <jointpos name="sy" joint="gy"/>
    <jointpos name="sz" joint="gz"/>
    <jointpos name="syaw" joint="gyaw"/>
  </sensor>
</mujoco>

<!--
  Zadanie 1.3 - Zbuduj latający chwytak (jutro będzie układał wieżę z klocków!)
  Uruchom:  uv run python -m mujoco.viewer --mjcf=dzien1/z3_chwytak.xml

  Chwytak wisi nad stołem jak w dźwigu bramowym i porusza się w 3 osiach + obraca wokół osi pionowej.
  Potrzebujesz:
    - ciała "gripper" z gravcomp="1" (kompensacja grawitacji - chwytak nie spada)
    - 4 przegubów:  gx, gy, gz  (type="slide", osie x, y, z)  oraz  gyaw (type="hinge", oś z)
    - kilku geomów, żeby było go widać (korpus, przyssawka na dole)
    - kamery "gripper_camera" patrzącej w dół (podgląd: lewy panel -> Rendering -> Camera)
    - 4 aktuatorów <position> (ax, ay, az, ayaw) - suwaki w panelu "Control"
    - dwóch palców: ciała-dzieci "finger_left" i "finger_right" (prostopadłościany pod korpusem),
      każde z przegubem slide jadącym do środka (fl: axis="0 -1 0", fr: axis="0 1 0", range="0 0.05"),
      sprzężenie <equality><joint joint1="fr" joint2="fl" solref="0.004 1"/></equality> (prawy palec naśladuje lewy)
      i jeden aktuator <position> "agrip" na przegubie fl (0 = otwarte, 0.05 = zamknięte)

  Test: zjedź nad klocek (az najniżej), zamknij palce (agrip), podnieś (az w górę). Klocek jedzie z Tobą?
  Palce trzymają klocek tylko tarciem - spróbuj zmniejszyć kp aktuatora agrip albo friction palców.

  Podpowiedź do kamery: kamera w MuJoCo patrzy wzdłuż swojej osi -z.
  xyaxes="0 -1 0  1 0 0" oznacza: oś x obrazu = -y świata, oś y obrazu = +x świata.
  Wtedy oś z kamery = x × y = (0, 0, 1), więc kamera patrzy w dół. Sprawdź!

  *  Jutrzejsze zadanie może używać TWOJEGO modelu: GripperSim(model_file="dzien1/z3_chwytak.xml").
     Nazwy muszą być takie jak wyżej, przyssawka to site "suction", a czujniki położenia
     przegubów to <jointpos> o nazwach sx, sy, sz, syaw.
-->
